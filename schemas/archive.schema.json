{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:harsanyi:archive:1",
  "title": "Harsanyi Proof Archive schema v1",
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "visibility": {"enum": ["private", "public"]},
    "sourceFile": {"type": "object", "required": ["path", "sha256", "size"], "properties": {"path": {"type": "string", "pattern": "^sources/"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "size": {"type": "integer", "minimum": 0}, "role": {"enum": ["main", "attachment"]}, "media_type": {"type": "string"}}},
    "manifest": {"type": "object", "required": ["schema_version", "paper_id", "version", "title", "authors", "publication_status", "source_type", "visibility", "files", "content_fingerprint"], "properties": {"schema_version": {"const": 1}, "paper_id": {"$ref": "#/$defs/id"}, "version": {"$ref": "#/$defs/id"}, "title": {"type": "string"}, "authors": {"type": "array"}, "publication_status": {"type": "string"}, "source_type": {"enum": ["manual", "public_url"]}, "visibility": {"$ref": "#/$defs/visibility"}, "source_url": {"type": ["string", "null"]}, "files": {"type": "array", "items": {"$ref": "#/$defs/sourceFile"}}}},
    "inventory": {"type": "object", "required": ["schema_version", "paper_id", "paper_version", "completeness_status", "denominator_reviewed", "items"], "properties": {"schema_version": {"const": 1}, "paper_id": {"$ref": "#/$defs/id"}, "paper_version": {"$ref": "#/$defs/id"}, "completeness_status": {"type": "string"}, "denominator_reviewed": {"type": "boolean"}, "items": {"type": "array"}}},
    "claim": {"type": "object", "required": ["schema_version", "claim_id", "paper_id", "paper_version", "source_location", "theorem_ids", "proof_ids", "review_status", "visibility"], "properties": {"schema_version": {"const": 1}, "claim_id": {"$ref": "#/$defs/id"}, "paper_id": {"$ref": "#/$defs/id"}, "paper_version": {"$ref": "#/$defs/id"}, "source_location": {"type": "object"}, "theorem_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "proof_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "visibility": {"$ref": "#/$defs/visibility"}}},
    "theorem": {"type": "object", "required": ["schema_version", "theorem_id", "title", "summary", "assumptions", "visibility", "proofs", "lean_declarations", "tags"], "properties": {"schema_version": {"const": 1}, "theorem_id": {"$ref": "#/$defs/id"}, "visibility": {"$ref": "#/$defs/visibility"}, "lean_declarations": {"type": "array"}}},
    "proof": {"type": "object", "required": ["schema_version", "proof_id", "theorem_id", "lean_declarations", "dependencies", "visibility"], "properties": {"schema_version": {"const": 1}, "proof_id": {"$ref": "#/$defs/id"}, "theorem_id": {"$ref": "#/$defs/id"}, "visibility": {"$ref": "#/$defs/visibility"}}},
    "issue": {"type": "object", "required": ["schema_version", "issue_id", "problem", "evidence", "assessment", "visibility", "user_confirmation", "fix_authorization", "status"], "properties": {"schema_version": {"const": 1}, "issue_id": {"$ref": "#/$defs/id"}, "claim_ids": {"type": "array"}, "theorem_ids": {"type": "array"}, "visibility": {"$ref": "#/$defs/visibility"}, "assessment": {"type": "string"}, "user_confirmation": {"type": "string"}, "fix_authorization": {"type": "string"}, "status": {"type": "string"}}}
  }
}
