import Lean.Util.CollectAxioms
import Harsanyi.Extensions.RobustnessFinite

open Lean Elab Command Meta
set_option pp.universes true
set_option pp.fullNames true
set_option pp.piBinderTypes true
run_cmd liftTermElabM do
  for name in #[`Harsanyi.Robustness.average, `Harsanyi.Robustness.contextAverage, `Harsanyi.Robustness.pairDelta, `Harsanyi.Robustness.multiOrderInteraction, `Harsanyi.Robustness.multiOrderAttribution, `Harsanyi.Robustness.average_add, `Harsanyi.Robustness.average_sub, `Harsanyi.Robustness.average_smul, `Harsanyi.Robustness.average_const, `Harsanyi.Robustness.pairDelta_add, `Harsanyi.Robustness.pairDelta_smul, `Harsanyi.Robustness.pairDelta_comm, `Harsanyi.Robustness.pairDelta_baseline, `Harsanyi.Robustness.interaction_linearity, `Harsanyi.Robustness.interaction_homogeneity, `Harsanyi.Robustness.interaction_commutativity, `Harsanyi.Robustness.interaction_baseline, `Harsanyi.Robustness.interaction_dummy, `Harsanyi.Robustness.attribution_linearity, `Harsanyi.Robustness.attribution_dummy, `Harsanyi.Robustness.attribution_top, `Harsanyi.Robustness.attribution_zero, `Harsanyi.Robustness.accumulation_telescope, `Harsanyi.Robustness.sum_insert_flags, `Harsanyi.Robustness.sum_erase_contexts, `Harsanyi.Robustness.sum_erase_same, `Harsanyi.Robustness.context_average_step, `Harsanyi.Robustness.attribution_recurrence, `Harsanyi.Robustness.factorial_average_orders, `Harsanyi.Robustness.shapley_orders, `Harsanyi.Robustness.shapley_efficiency, `Harsanyi.Robustness.attribution_efficiency, `Harsanyi.Robustness.average_sum, `Harsanyi.Robustness.attribution_accumulation, `Harsanyi.Robustness.triangular_sum, `Harsanyi.Robustness.average_map, `Harsanyi.Robustness.contextAverage_map, `Harsanyi.Robustness.attribution_relabel, `Harsanyi.Robustness.interaction_relabel, `Harsanyi.Robustness.swap_map_self, `Harsanyi.Robustness.swap_game_of_cooperation, `Harsanyi.Robustness.attribution_congr, `Harsanyi.Robustness.interaction_congr, `Harsanyi.Robustness.attribution_symmetry, `Harsanyi.Robustness.interaction_symmetry, `Harsanyi.Robustness.order_sum_accumulation, `Harsanyi.Robustness.interaction_efficiency, `Harsanyi.Robustness.conditionalMI, `Harsanyi.Robustness.conditionalCoI, `Harsanyi.Robustness.entropy_interaction, `Harsanyi.Robustness.entropy_shared_benefit, `Harsanyi.Robustness.average_abs_le, `Harsanyi.Robustness.disentanglement_bounds, `Harsanyi.Robustness.disentanglement_zero_domain, `Harsanyi.Robustness.cardinalGame, `Harsanyi.Robustness.cardinal_game_interaction, `Harsanyi.Robustness.fixed_size_cardinal_mean, `Harsanyi.Robustness.fixed_size_floor_counterexample, `Harsanyi.Robustness.attribution_homogeneity, `Harsanyi.Robustness.shapley_linearity, `Harsanyi.Robustness.shapley_homogeneity, `Harsanyi.Robustness.shapley_dummy, `Harsanyi.Robustness.shapley_symmetry, `Harsanyi.Robustness.interaction_sub, `Harsanyi.Robustness.attribution_sub, `Harsanyi.Robustness.attacking_decomposition, `Harsanyi.Robustness.source_dummy_baseline, `Harsanyi.Robustness.source_shapley_dummy, `Harsanyi.Robustness.conditionalShapleyDifference, `Harsanyi.Robustness.shapley_interaction_orders, `Harsanyi.Robustness.source_attack_decomposition, `Harsanyi.Robustness.flag_count_identity, `Harsanyi.Robustness.average_nonneg, `Harsanyi.Robustness.average_nonpos, `Harsanyi.Robustness.disentanglement_same_sign_nonneg, `Harsanyi.Robustness.disentanglement_same_sign_nonpos, `Harsanyi.Robustness.shapley_interaction_commutativity, `Harsanyi.Robustness.linearMaskedSum, `Harsanyi.Robustness.linear_masked_sum_cardinal, `Harsanyi.factorialShapley] do
    let info ← getConstInfo name
    let signature ← ppExpr info.type
    let axioms ← Lean.collectAxioms name
    let deps := info.type.getUsedConstants ++ (info.value?.map Expr.getUsedConstants).getD #[]
    let kind := match info with | .thmInfo _ => "theorem" | _ => "definition"
    liftM <| IO.println ("FOUNDATIONS_API:" ++ (Json.mkObj [
      ("name", toJson name.toString), ("signature", toJson signature.pretty),
      ("kind", toJson kind), ("axioms", toJson (axioms.map Name.toString)),
      ("dependencies", toJson (deps.map Name.toString))]).compress)
