Harsanyi.Robustness.pairDelta_baseline.{u_1} {α : Type u_1} [DecidableEq α] (g : Harsanyi.Game α) (i j : α)
  (S : Finset α) (b : ℝ) :
  Harsanyi.Robustness.pairDelta (fun S => g S - b) i j S = Harsanyi.Robustness.pairDelta g i j S
Harsanyi.Robustness.pairDelta_smul.{u_1} {α : Type u_1} [DecidableEq α] (g : Harsanyi.Game α) (i j : α) (S : Finset α)
  (a : ℝ) : Harsanyi.Robustness.pairDelta (fun S => a * g S) i j S = a * Harsanyi.Robustness.pairDelta g i j S
Harsanyi.Robustness.average_smul.{u_2} {β : Type u_2} (s : Finset β) (f : β → ℝ) (a : ℝ) :
  (Harsanyi.Robustness.average s fun t => a * f t) = a * Harsanyi.Robustness.average s f
DirectImportConsumer.affine_masked_pair_interaction.{u_1, u_2} {α : Type u_1} {X : Type u_2} [DecidableEq α] (v : X → ℝ)
  (mask : Finset α → X) (N : Finset α) (i j : α) (m : ℕ) (a b : ℝ) :
  Harsanyi.Robustness.multiOrderInteraction (fun S => a * v (mask S) + b) N i j m =
    a * Harsanyi.Robustness.multiOrderInteraction (fun S => v (mask S)) N i j m
'DirectImportConsumer.affine_masked_pair_interaction' depends on axioms: [propext, Classical.choice, Quot.sound]
