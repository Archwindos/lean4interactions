{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Full formal-paper local package",
  "type": "object",
  "required": [
    "schema_version",
    "resources",
    "tools",
    "nodes",
    "edges",
    "validation"
  ],
  "properties": {
    "schema_version": {
      "const": "3.0"
    },
    "resources": {
      "type": "array"
    },
    "tools": {
      "type": "array"
    },
    "nodes": {
      "type": "array"
    },
    "edges": {
      "type": "array"
    },
    "validation": {
      "type": "object"
    }
  }
}
