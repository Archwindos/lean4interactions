      "statement": "∀ {X : Type u_1} {n : Nat} (v : X → Real) (mask : Finset.{0} (Fin n) → X) (S : Finset.{0} (Fin n)),\n  Eq.{1} (∑ T ∈ Finset.powerset.{0} S, Harsanyi.interaction.{0} (ReaderV2.maskedGame.{u_1} v mask) T) (v (mask S))",
