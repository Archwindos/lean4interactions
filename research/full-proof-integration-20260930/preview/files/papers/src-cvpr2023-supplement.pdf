/S/Span<</ActualText(\040\040\\Delta\040v_{\\mathcal\040{T}}\(\\boldsymbol\040{x}_{\\mathcal\040{S}}\)\040=&\040\\sum\040_{\\mathcal\040{L}\\subseteq\040\\mathcal\040{T}}\(-1\)^{|\\mathcal\040{T}|-|\\mathcal\040{L}|}v\(\\boldsymbol\040{x}_{\\mathcal\040{L}\\cup\040\\mathcal\040{S}}\)\\\\\040=&\040\\sum\040_{\\mathcal\040{L}\\subseteq\040\\mathcal\040{T}}\040\(-1\)^{|\\mathcal\040{T}|-|\\mathcal\040{L}|}\\sum\040_{\\mathcal\040{K}\\subseteq\040\\mathcal\040{L}\\cup\040\\mathcal\040{S}}\040w_{\\mathcal\040{K}}\040\\quad\040\\text\040{//\040by\040Theorem\040\\ref\040{th:harsanyi-faithful}}\\\\\040=&\040\\sum\040_{\\mathcal\040{L}\\subseteq\040\\mathcal\040{T}}\040\(-1\)^{|\\mathcal\040{T}|-|\\mathcal\040{L}|}\\sum\040_{\\mathcal\040{L}'\\subseteq\040\\mathcal\040{L}}\\sum\040_{\\mathcal\040{S}'\\subseteq\040\\mathcal\040{S}}\040w_{\\mathcal\040{L}'\\cup\040\\mathcal\040{S}'}\040\\quad\040\\text\040{//\040since\040$\\mathcal\040{L}\\cap\040\\mathcal\040{S}=\\emptyset\040$}\\\\\040=&\040\\sum\040_{\\mathcal\040{S}'\\subseteq\040\\mathcal\040{S}}\\left\040[\\sum\040_{\\mathcal\040{L}\\subseteq\040\\mathcal\040{T}}\040\(-1\)^{|\\mathcal\040{T}|-|\\mathcal\040{L}|}\040\\sum\040_{\\mathcal\040{L}'\\subseteq\040\\mathcal\040{L}}\040w_{\\mathcal\040{L}'\\cup\040\\mathcal\040{S}'}\\right\040]\\\\\040=&\040\\sum\040_{\\mathcal\040{S}'\\subseteq\040\\mathcal\040{S}}\\left\040[\\sum\040_{\\mathcal\040{L}'\\subseteq\040\\mathcal\040{T}}\\sum\040_{\\substack\040{\\mathcal\040{L}\\subseteq\040\\mathcal\040{T}\\\\\040\\mathcal\040{L}\\supseteq\040\\mathcal\040{L}'}}\(-1\)^{|\\mathcal\040{T}|-|\\mathcal\040{L}|}w_{\\mathcal\040{L}'\\cup\040\\mathcal\040{S}'}\\right\040]\\\\\040=&\040\\sum\040_{\\mathcal\040{S}'\\subseteq\040\\mathcal\040{S}}\\left\040[\\underbrace\040{w_{\\mathcal\040{S}'\\cup\040\\mathcal\040{T}}}_{\\mathcal\040{L}'=\\mathcal\040{T}}\040+\040\\underbrace\040{\\sum\040_{\\mathcal\040{L}'\\subsetneq\040\\mathcal\040{T}}\\left\040\(\\sum\040_{l=|\\mathcal\040{L}'|}^{|\\mathcal\040{T}|}\\binom\040{|\\mathcal\040{T}|-|\\mathcal\040{L}'|}{l-|\\mathcal\040{L}'|}\(-1\)^{|\\mathcal\040{T}|-|\\mathcal\040{L}|}w_{\\mathcal\040{L}'\\cup\040\\mathcal\040{S}'}\\right\040\)}_{L'\\subsetneq\040\\mathcal\040{T}}\\right\040]\\\\\040=&\040\\sum\040_{\\mathcal\040{S}'\\subseteq\040\\mathcal\040{S}}\\left\040[w_{\\mathcal\040{S}'\\cup\040\\mathcal\040{T}}\040+\040\\sum\040_{\\mathcal\040{L}'\\subsetneq\040\\mathcal\040{T}}\\left\040\(w_{\\mathcal\040{L}'\\cup\040\\mathcal\040{S}'}\\cdot\040\\underbrace\040{\\sum\040_{l=|\\mathcal\040{L}'|}^{|\\mathcal\040{T}|}\\binom\040{|\\mathcal\040{T}|-|\\mathcal\040{L}'|}{l-|\\mathcal\040{L}'|}\(-1\)^{|\\mathcal\040{T}|-|\\mathcal\040{L}|}}_{=0}\\right\040\)\\right\040]\\\\\040=&\040\\sum\040_{\\mathcal\040{S}'\\subseteq\040\\mathcal\040{S}}\040w_{\\mathcal\040{S}'\\cup\040\\mathcal\040{T}}\040\\qed)>>BDC
