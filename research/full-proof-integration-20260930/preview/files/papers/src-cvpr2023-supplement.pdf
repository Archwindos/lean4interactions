hcal\040{L}}}\040w_{\\mathcal\040{L}\\cup\040\\{i\\}}\\\\\040=&\040\\frac\040{1}{|\\mathcal\040{N}|}\\sum\040_{\\mathcal\040{L}\\subseteq\040\\mathcal\040{N}\\backslash\040\\{i\\}}\040\\sum\040_{m=|\\mathcal\040{L}|}^{|\\mathcal\040{N}|-1}\040\\frac\040{1}{\\binom\040{|\\mathcal\040{N}|-1}{m}}\\sum\040_{\\scriptsize\040\\substack\040{\\mathcal\040{S}\\subseteq\040\\mathcal\040{N}\\backslash\040\\{i\\}\\\\|\\mathcal\040{S}|=m\\\\\040\\mathcal\040{S}\\supseteq\040\\mathcal\040{L}}}\040w_{\\mathcal\040{L}\\cup\040\\{i\\}}\040\\quad\040\\text\040{//\040since\040{\\small\040$\\mathcal\040{S}\\supseteq\040\\mathcal\040{L}$},\040{\\small\040$|\\mathcal\040{S}|=m\\geq\040|\\mathcal\040{L}|$}.}\\\\\040=&\040\\frac\040{1}{|\\mathcal\040{N}|}\\sum\040_{\\mathcal\040{L}\\subseteq\040\\mathcal\040{N}\\backslash\040\\{i\\}}\040\\sum\040_{m=|\\mathcal\040{L}|}^{|\\mathcal\040{N}|-1}\040\\frac\040{1}{\\binom\040{|\\mathcal\040{N}|-1}{m}}\\cdot\040\\binom\040{|\\mathcal\040{N}|-|\\mathcal\040{L}|-1}{m-|\\mathcal\040{L}|}\\cdot\040w_{\\mathcal\040{L}\\cup\040\\{i\\}}\\\\\040=&\040\\frac\040{1}{|\\mathcal\040{N}|}\\sum\040_{\\mathcal\040{L}\\subseteq\040\\mathcal\040{N}\\backslash\040\\{i\\}}w_{\\mathcal\040{L}\\cup\040\\{i\\}}\040\\underbrace\040{\\sum\040_{k=0}^{|\\mathcal\040{N}|-|\\mathcal\040{L}|-1}\\frac\040{1}{\\binom\040{|\\mathcal\040{N}|-1}{|\\mathcal\040{L}|+k}}\\cdot\040\\binom\040{|\\mathcal\040{N}|-|\\mathcal\040{L}|-1}{k}}_{\\alpha\040_\\mathcal\040{L}})>>BDC
