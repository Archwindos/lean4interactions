/S/Span<</ActualText(\040\040I^{\\textrm\040{Shapley-Taylor}\(k\)}\(\\mathcal\040{T}\)\040=&\040\\frac\040{k}{|\\mathcal\040{N}|}\\sum\040_{\\mathcal\040{S}\\subseteq\040\\mathcal\040{N}\\backslash\040\\mathcal\040{T}}\\frac\040{1}{\\binom\040{|\\mathcal\040{N}|-1}{|\\mathcal\040{S}|}}\\cdot\040\\Delta\040v_\\mathcal\040{T}\(\\boldsymbol\040{x}_{\\mathcal\040{S}}\)\\\\\040=&\040\\frac\040{k}{|\\mathcal\040{N}|}\\sum\040_{m=0}^{|\\mathcal\040{N}|-k}\\sum\040_{\\scriptsize\040\\substack\040{\\mathcal\040{S}\\subseteq\040\\mathcal\040{N}\\backslash\040\\mathcal\040{T}\\\\|\\mathcal\040{S}|=m}}\\frac\040{1}{\\binom\040{|\\mathcal\040{N}|-1}{|\\mathcal\040{S}|}}\\cdot\040\\Delta\040v_\\mathcal\040{T}\(\\boldsymbol\040{x}_{\\mathcal\040{S}}\)\\\\\040=&\040\\frac\040{k}{|\\mathcal\040{N}|}\\sum\040_{m=0}^{|\\mathcal\040{N}|-k}\\sum\040_{\\scriptsize\040\\substack\040{\\mathcal\040{S}\\subseteq\040\\mathcal\040{N}\\backslash\040\\mathcal\040{T}\\\\|\\mathcal\040{S}|=m}}\\frac\040{1}{\\binom\040{|\\mathcal\040{N}|-1}{|\\mathcal\040{S}|}}\040\\left\040[\\sum\040_{\\mathcal\040{L}\\subseteq\040\\mathcal\040{S}}\040w_{\\mathcal\040{L}\\cup\040\\mathcal\040{T}}\040\\right\040]\\\\\040=&\040\\frac\040{k}{|\\mathcal\040{N}|}\\sum\040_{\\mathcal\040{L}\\subseteq\040\\mathcal\040{N}\\backslash\040\\mathcal\040{T}}\\sum\040_{m=|\\mathcal\040{L}|}^{|\\mathcal\040{N}|-k}\\frac\040{1}{\\binom\040{|\\mathcal\040{N}|-1}{|\\mathcal\040{S}|}}\\sum\040_{\\scriptsize\040\\substack\040{\\mathcal\040{S}\\subseteq\040\\mathcal\040{N}\\backslash\040\\mathcal\040{T}\\\\|\\mathcal\040{S}|=m\\\\\\mathcal\040{S}\\supseteq\040\\mathcal\040{L}}}\040w_{\\mathcal\040{L}\\cup\040\\mathcal\040{T}}\040\\\\\040=&\040\\frac\040{k}{|\\mathcal\040{N}|}\\sum\040_{\\mathcal\040{L}\\subseteq\040\\mathcal\040{N}\\backslash\040\\mathcal\040{T}}\\sum\040_{m=|\\mathcal\040{L}|}^{|\\mathcal\040{N}|-k}\\frac\040{1}{\\binom\040{|\\mathcal\040{N}|-1}{|\\mathcal\040{S}|}}\\binom\040{|\\mathcal\040{N}|-|\\mathcal\040{L}|-k}{m-|\\mathcal\040{L}|}\040w_{\\mathcal\040{L}\\cup\040\\mathcal\040{T}}\040\\\\\040=&\040\\frac\040{k}{|\\mathcal\040{N}|}\\sum\040_{\\mathcal\040{L}\\subseteq\040\\mathcal\040{N}\\backslash\040\\mathcal\040{T}}\040w_{\\mathcal\040{L}\\cup\040\\mathcal\040{T}}\040\\underbrace\040{\\sum\040_{m=0}^{|\\mathcal\040{N}|-|\\mathcal\040{L}|-k}\\frac\040{1}{\\binom\040{|\\mathcal\040{N}|-1}{|\\mathcal\040{L}|+m}}\\binom\040{|\\mathcal\040{N}|-|\\mathcal\040{L}|-k}{m}}_{\\alpha\040_\\mathcal\040{L}})>>BDC
